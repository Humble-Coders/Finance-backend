# Variable NAMES only. Never commit real values — this repo is public.
# Real values live in the Render environment group `finai-shared`.

APP_ENV=development

# Supabase — Transaction pooler connection string (port 6543), NOT the direct
# :5432 string. Paste Supabase's string as-is; the app coerces the scheme to
# +asyncpg and drops libpq-only params like sslmode (see app/core/dsn.py).
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:6543/postgres

# Migrations only. SESSION pooler — port 5432, same host and credentials.
# DDL through the transaction pooler is cancelled by its statement timeout.
# Optional: falls back to DATABASE_URL when unset (correct for plain Postgres).
# Any '@' or '/' inside the password must be percent-encoded (%40, %2F).
MIGRATION_DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/postgres

SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=          # backend only — never ships to any client
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=                # legacy HS256 projects only; prefer JWKS

# AI provider. Statement parsing is the only thing that calls a model.
# DOCUMENT_AI_CREDENTIALS is gone: since 2026-09-21 extraction happens on the
# device and no document-AI vendor is used (PRD F2).
LLM_API_KEY=
LLM_PROVIDER=gemini                 # gemini | openai | groq | openrouter | anthropic
LLM_MODEL=gemini-2.0-flash
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# REQUIRED IN PRODUCTION. Set to true only once LLM_API_KEY is a business API
# tier whose terms forbid training on the data we send (PRD Appendix A.3). The
# consent screen tells users this as fact, so production refuses to parse a
# statement while it is false. A free tier is fine for development against
# synthetic fixtures — never against a real statement.
LLM_NO_TRAINING_TIER=false

# Free-tier allowance. One import per household per calendar month (PRD F2);
# raise it locally rather than rationing development by the production plan.
# Ticket 7.1 moves this into entitlements.
FREE_IMPORTS_PER_MONTH=1

# Queue
EXTRACTION_QUEUE_NAME=extraction_jobs
